+      setError('Enter a quantity greater than zero.');
+      return;
+    }
+    const remaining = remainingFor(item);
+    const usingOverride = overrideItemId === item.id;
+
+    if (!usingOverride && remaining != null && qty > remaining) {
+      setError(`Only ${remaining} remaining on this prescription line. Use the override if this is authorized (e.g. lost/damaged medication).`);
+      return;
+    }
+    if (usingOverride && !overrideReason.trim()) {
+      setError('An override reason is required.');
+      return;
+    }
+
+    setSubmittingItemId(item.id);
+    const { data: medicine } = await supabase.from('medicines').select('unit_price').eq('id', item.medicine_id).single();
+    const unitPrice = medicine?.unit_price || 0;
+
+    const { error: insertError } = await supabase.from('invoice_items').insert({
+      invoice_id: invoiceId,
+      item_type: 'medicine',
+      description: item.medicine?.name || 'Medicine',
+      quantity: qty,
+      unit_price: unitPrice,
+      total_price: qty * unitPrice,
+      reference_id: item.medicine_id,
+      prescription_item_id: item.id,
+      ...(usingOverride ? {
+        quantity_override_reason: overrideReason.trim(),
+        quantity_override_by: currentUserId,
+        quantity_override_at: new Date().toISOString(),
+      } : {}),
+    });
+
+    setSubmittingItemId(null);
+    if (insertError) {
+      // The database trigger (migration 031, extended) is the real
+      // enforcement -- this message surfaces whatever it raised
+      // (superseded prescription, or exceeds remaining quantity) rather
+      // than assuming the client-side check above was the only gate.
+      setError(insertError.message);
+      return;
+    }
+
+    setQtyInputs(q => ({ ...q, [item.id]: '' }));
+    setOverrideItemId(null);
+    setOverrideReason('');
+    await fetchPrescribed();
+    onAdded();
+  }
+
+  return (
+    <Modal isOpen={isOpen} onClose={onClose} title="Prescribed Medicines" size="lg">
+      <div className="space-y-4">
+        <p className="text-xs text-gray-500">
+          Purchases are tracked across every invoice, not just this one — a patient can buy part of a
+          prescription today and the rest on a later visit.
+        </p>
+        {error && <p className="text-sm text-red-600 bg-red-50 rounded-lg px-3 py-2">{error}</p>}
+        {loading ? <div className="py-8 text-center text-sm text-gray-500">Loading...</div> :
+        prescriptions.length === 0 ? <p className="py-8 text-center text-sm text-gray-500">No prescriptions found for this patient.</p> : (
+          <div className="max-h-[28rem] space-y-4 overflow-y-auto">
+            {prescriptions.map(p => (
+              <div key={p.id} className="rounded-lg border border-gray-200 p-3">
+                <p className="mb-2 text-sm font-semibold text-gray-900">
+                  {p.prescription_number} — {formatDate(p.created_at)}
+                  {p.diagnosis && <span className="ml-2 font-normal text-gray-500">{p.diagnosis}</span>}
+                </p>
+                {p.items.length === 0 ? <p className="text-xs text-gray-400">No medicine lines on this prescription.</p> : (
+                  <div className="space-y-2">
+                    {p.items.map(item => {
+                      const remaining = remainingFor(item);
+                      const isDepleted = remaining != null && remaining <= 0;
+                      return (
+                        <div key={item.id} className="flex flex-wrap items-center gap-2 rounded-lg bg-gray-50 px-3 py-2">
+                          <div className="min-w-[10rem] flex-1">
+                            <p className="text-sm font-medium text-gray-900">{item.medicine?.name}</p>
+                            <p className="text-xs text-gray-500">
+                              {item.dosage} · {item.frequency} ·{' '}
+                              {remaining == null ? 'no cap recorded' : `${Math.max(remaining, 0)} of ${item.quantity} remaining`}
+                            </p>
+                          </div>
+                          <input
+                            type="number" min="0" step="0.5"
+                            value={qtyInputs[item.id] || ''}
+                            onChange={e => setQtyInputs(q => ({ ...q, [item.id]: e.target.value }))}
+                            className="input w-24 py-1"
+                            placeholder="Qty"
+                            disabled={isDepleted && overrideItemId !== item.id}
+                          />
+                          <button
+                            onClick={() => handleAddPurchase(item)}
+                            disabled={submittingItemId === item.id}
+                            className="btn-primary py-1 px-3 text-xs"
+                          >
+                            Add
+                          </button>
+                          {canOverride && (
+                            overrideItemId === item.id ? (
+                              <div className="flex w-full items-center gap-2 pt-1">
+                                <input
+                                  value={overrideReason}
+                                  onChange={e => setOverrideReason(e.target.value)}
+                                  className="input flex-1 py-1 text-xs"
+                                  placeholder="Override reason (e.g. lost/damaged medication)"
+                                />
+                                <button onClick={() => { setOverrideItemId(null); setOverrideReason(''); }} className="text-xs text-gray-500 hover:text-gray-700">
+                                  Cancel override
+                                </button>
+                              </div>
+                            ) : (
+                              <button
+                                onClick={() => { setOverrideItemId(item.id); setOverrideReason(''); }}
+                                className="text-xs text-amber-700 hover:text-amber-900"
+                              >
+                                Override cap
+                              </button>
+                            )
+                          )}
+                        </div>
+                      );
+                    })}
+                  </div>
+                )}
+              </div>
+            ))}
+          </div>
+        )}
+        <div className="flex justify-end">
+          <button onClick={onClose} className="btn-secondary">Close</button>
+        </div>
+      </div>
+    </Modal>
+  );
