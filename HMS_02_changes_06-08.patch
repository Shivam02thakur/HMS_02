+// ============================================================
+// Prescribed Medicines modal (#9) — a patient should be able to buy 0-N
+// of what was actually prescribed, across however many separate visits
+// that ends up split over. Scoped to THIS patient's prescriptions with
+// LIVE remaining-quantity tracking, which is a fundamentally different
+// question from "search the medicine catalog" (the generic Add Item
+// flow above).
+//
+// Fetches every non-superseded prescription for the patient, with items;
+// separately fetches EVERY invoice_items row referencing each
+// prescription item -- deliberately not scoped to the current invoice,
+// since the whole point is tracking purchases across every invoice that
+// item has ever appeared on (a patient can buy some on day 1 and the
+// rest on day 5, on a completely different invoice/episode).
+// ============================================================
+
+interface PrescribedMedicinesModalProps {
+  isOpen: boolean;
+  onClose: () => void;
+  invoiceId: string;
+  patientId: string;
+  canOverride: boolean;
+  currentUserId?: string;
+  onAdded: () => void;
+}
+
+function PrescribedMedicinesModal({ isOpen, onClose, invoiceId, patientId, canOverride, currentUserId, onAdded }: PrescribedMedicinesModalProps) {
+  const [prescriptions, setPrescriptions] = useState<Array<{
+    id: string; prescription_number: string; diagnosis: string | null; created_at: string;
+    items: Array<{ id: string; medicine_id: string; dosage: string; frequency: string; quantity: number | null; medicine?: { name: string } }>;
+  }>>([]);
+  const [purchasedByItem, setPurchasedByItem] = useState<Record<string, number>>({});
+  const [loading, setLoading] = useState(false);
+  const [qtyInputs, setQtyInputs] = useState<Record<string, string>>({});
+  const [overrideItemId, setOverrideItemId] = useState<string | null>(null);
+  const [overrideReason, setOverrideReason] = useState('');
+  const [error, setError] = useState('');
+  const [submittingItemId, setSubmittingItemId] = useState<string | null>(null);
+
+  useEffect(() => { if (isOpen) fetchPrescribed(); }, [isOpen, patientId]);
+
+  async function fetchPrescribed() {
+    setLoading(true);
+    setError('');
+    const { data: presData, error: presErr } = await supabase
+      .from('prescriptions')
+      .select('id, prescription_number, diagnosis, created_at, items:prescription_items(id, medicine_id, dosage, frequency, quantity, medicine:medicines(name))')
+      .eq('patient_id', patientId)
+      .is('superseded_by', null)
+      .order('created_at', { ascending: false });
+
+    if (presErr) {
+      console.error('Failed to load prescriptions:', presErr);
+      setError('Could not load prescriptions.');
+      setLoading(false);
+      return;
+    }
+
+    const list = (presData || []) as unknown as typeof prescriptions;
+    setPrescriptions(list);
+
+    const allItemIds = list.flatMap(p => p.items.map(i => i.id));
+    if (allItemIds.length === 0) {
+      setPurchasedByItem({});
+      setLoading(false);
+      return;
+    }
+
+    // NOT scoped to `invoiceId` -- this is the whole point: track
+    // purchases across every invoice this prescription item has ever
+    // appeared on, so day 5's purchase (on a different invoice) sees
+    // what day 1 already bought.
+    const { data: purchases, error: purchErr } = await supabase
+      .from('invoice_items')
+      .select('prescription_item_id, quantity')
+      .in('prescription_item_id', allItemIds);
+
+    if (purchErr) {
+      console.error('Failed to load existing purchases:', purchErr);
+    }
+
+    const totals: Record<string, number> = {};
+    for (const row of purchases || []) {
+      if (!row.prescription_item_id) continue;
+      totals[row.prescription_item_id] = (totals[row.prescription_item_id] || 0) + Number(row.quantity || 0);
+    }
